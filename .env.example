# Variables del frontend.
#
# Las variables VITE_* se inyectan en el frontend durante el build.
# Las variables exclusivas del backend viven en backend/.env.example.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me
VITE_SUPERADMIN_EMAIL=root@root.com
VITE_SUPERADMIN_PASSWORD=change-root-password

# En desarrollo la app apunta automaticamente a http://localhost:3000.
# En produccion define la URL publica del backend si frontend y API van separados.
# VITE_ENABLE_REMOTE_STORAGE=true
# VITE_API_BASE_URL=https://tu-backend.onrender.com
