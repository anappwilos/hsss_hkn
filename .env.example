# Credenciales del acceso administrador de AdoraPlus.
# Nota: las variables VITE_* se inyectan en el frontend durante el build.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me

# Persistencia local/remota.
DATABASE_URL=postgresql://adoraplus:adoraplus_dev@localhost:5432/adoraplus
VITE_ENABLE_REMOTE_STORAGE=true
VITE_API_BASE_URL=http://localhost:3000

# Define true solo si tu proveedor PostgreSQL exige SSL para DATABASE_URL.
DATABASE_SSL=false
