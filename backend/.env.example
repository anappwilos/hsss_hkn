PORT=3000

# Persistencia del backend.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://a_solas:a_solas_dev@localhost:5432/a_solas
DATABASE_SSL=false

# Para usar JSON temporal en vez de PostgreSQL, cambia las tres lineas
# anteriores por estas:
# STORAGE_DRIVER=json
# JSON_DATA_FILE=../data/a-solas-state.json

# CORS. Usa el dominio del frontend si se despliega separado.
# En desarrollo se permite Vite local automaticamente.
# CORS_ORIGIN=http://localhost:5173

# Credenciales administrativas virtuales usadas por la API.
# No se guardan como filas en la tabla usuarios.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me
VITE_SUPERADMIN_EMAIL=root@root.com
VITE_SUPERADMIN_PASSWORD=change-root-password

# Usuarios semilla no administrativos.
# Formato: Nombre|Apellidos|email|frecuencia|telefono|password;...
# Se insertan/actualizan como filas normales en la tabla usuarios.
SEED_USERS=Gabi|Aguilera Fernandez|gabi.aguilera.fernandez@example.com|fijo||;Nicolas|Alarcon Rapela|nicolas.alarcon.rapela@example.com|suplente||
